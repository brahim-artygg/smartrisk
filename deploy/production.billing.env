APP_BASE_URL=https://smartrisk.io
# SmartRisk production crypto billing — public/non-secret configuration
SMARTRISK_BILLING_ENABLED=true
SMARTRISK_BILLING_REQUIRED=true
SMARTRISK_PAYMENT_RECEIVER=0x5a9fe13fbcc6055144e594391adf30ecb287e5cf
SMARTRISK_PAYMENT_USDT_CONTRACT=0xdac17f958d2ee523a2206206994597c13d831ec7
SMARTRISK_PAYMENT_INVOICE_TTL_MINUTES=30
SMARTRISK_PAYMENT_POLL_SECONDS=15
SMARTRISK_PAYMENT_SCAN_LOOKBACK_BLOCKS=100
SMARTRISK_PAYMENT_SCAN_CHUNK=1000

# Configure the Ethereum RPC in the deployment secret store; do not commit credentials.
# Preferred: SMARTRISK_PAYMENT_RPC_URL=https://<authenticated-ethereum-rpc>
# Fallback: ALCHEMY_API_KEY=<secret>
# Fallback: ALCHEMY_RPC_URL=https://<authenticated-ethereum-rpc>
# Optional redundancy: QUICKNODE_RPC_URL=<authenticated-rpc>
# Optional redundancy: CHAINSTACK_RPC_URL=<authenticated-rpc>
